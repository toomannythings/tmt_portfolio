---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('work');
const works = entries.sort((a, b) => {
  if (b.data.year !== a.data.year) return b.data.year - a.data.year;
  return a.data.order - b.data.order;
});
---
<Base title="Герман Сенин — видеомонтаж">
  <section class="hero" aria-label="Заставка">
    <svg class="hero-arcs" viewBox="0 0 800 800" aria-hidden="true">
      <circle cx="760" cy="120" r="90" />
      <circle cx="760" cy="120" r="180" />
      <circle cx="760" cy="120" r="270" />
      <circle cx="760" cy="120" r="360" />
    </svg>

    <div class="hero-inner wrap">
      <p class="hero-eyebrow">Видеомонтаж — Казахстан / удалённо</p>
      <h1 class="hero-name">Hermann</h1>

      <dl class="hero-meta">
        <div>
          <dt>Специализация</dt>
          <dd>Монтаж, режиссура монтажа, постпродакшн</dd>
        </div>
        <div>
          <dt>Подход</dt>
          <dd>Темп и ритм под звук — опыт коротких вирусных форматов</dd>
        </div>
        <div>
          <dt>Статус</dt>
          <dd>Открыт для проектов</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="index wrap" aria-label="Список работ">
    <div class="index-head hairline-bottom">
      <span>Работа</span>
      <span class="only-wide">Категория</span>
      <span>Год</span>
    </div>

    {works.map((work) => (
      <a class="index-row hairline-bottom" href={`/work/${work.slug}`} data-preview={work.data.poster}>
        <span class="row-thumb">
          <img src={work.data.poster} alt="" loading="lazy" />
        </span>
        <span class="row-title">{work.data.title}</span>
        <span class="row-category only-wide">{work.data.category}</span>
        <span class="row-year">{work.data.year}</span>
      </a>
    ))}

    {works.length === 0 && (
      <p class="empty hairline-bottom">Работы ещё не добавлены. Загрузите первый проект через админ‑панель по адресу /admin.</p>
    )}
  </section>

  <div id="preview" class="preview" aria-hidden="true">
    <img id="preview-img" alt="" />
  </div>

  <style>
    .hero {
      position: relative;
      background: var(--ink);
      color: var(--bg);
      overflow: hidden;
    }

    .hero-arcs {
      position: absolute;
      top: 0;
      right: 0;
      width: min(70vw, 800px);
      height: auto;
      opacity: 0.9;
    }

    .hero-arcs circle {
      fill: none;
      stroke: var(--bg);
      stroke-width: 1;
      opacity: 0.35;
    }

    .hero-inner {
      position: relative;
      padding-top: clamp(64px, 11vw, 120px);
      padding-bottom: clamp(48px, 8vw, 96px);
    }

    .hero-eyebrow {
      margin: 0 0 8px;
      font-size: 0.85rem;
      color: var(--grey-light);
    }

    .hero-name {
      margin: 0;
      font-weight: 900;
      letter-spacing: -0.04em;
      line-height: 0.82;
      font-size: clamp(4.5rem, 20vw, 15rem);
    }

    .hero-meta {
      margin: clamp(32px, 6vw, 56px) 0 0;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
      max-width: 900px;
      border-top: 1px solid rgba(255, 255, 255, 0.25);
      padding-top: 20px;
    }

    .hero-meta dt {
      font-size: 0.75rem;
      color: var(--grey-light);
    }

    .hero-meta dd {
      margin: 6px 0 0;
      font-size: 0.95rem;
      line-height: 1.4;
    }

    .index {
      padding-top: 8px;
    }

    .index-head,
    .index-row {
      display: grid;
      grid-template-columns: 56px 1fr 180px 90px;
      align-items: center;
      gap: 16px;
      padding: 14px 0;
    }

    .index-head {
      color: var(--grey);
      font-size: 0.8rem;
      padding-top: 12px;
      padding-bottom: 10px;
    }

    .index-head span:first-child {
      grid-column: 2;
    }

    .index-row {
      font-size: var(--step-2);
      font-weight: 600;
      letter-spacing: -0.01em;
      transition: opacity 0.15s ease;
    }

    .index-row:hover,
    .index-row:focus-visible {
      opacity: 0.55;
    }

    .row-thumb {
      display: block;
      width: 56px;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: var(--ink);
    }

    .row-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(1) contrast(1.35);
    }

    .row-category {
      font-size: 0.85rem;
      color: var(--grey);
      font-weight: 400;
    }

    .row-year {
      font-size: 0.85rem;
      color: var(--grey);
      font-weight: 400;
      font-variant-numeric: tabular-nums;
      text-align: right;
    }

    .only-wide {
      display: none;
    }

    @media (min-width: 640px) {
      .only-wide {
        display: block;
      }
    }

    .empty {
      color: var(--grey);
      padding: 32px 0;
    }

    .preview {
      position: fixed;
      top: 0;
      left: 0;
      width: 300px;
      aspect-ratio: 16 / 10;
      pointer-events: none;
      opacity: 0;
      transform: translate(-1000px, -1000px);
      transition: opacity 0.15s ease;
      z-index: 40;
      border: 1px solid var(--ink);
      background: var(--ink);
    }

    .preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(1) contrast(1.35);
    }

    .preview.is-visible {
      opacity: 1;
    }

    @media (hover: none) {
      .preview {
        display: none;
      }
    }

    @media (max-width: 640px) {
      .index-head,
      .index-row {
        grid-template-columns: 44px 1fr 70px;
      }

      .index-head span:first-child {
        grid-column: 2;
      }

      .row-thumb {
        width: 44px;
      }
    }
  </style>

  <script>
    const preview = document.getElementById('preview');
    const previewImg = document.getElementById('preview-img') as HTMLImageElement | null;
    const rows = document.querySelectorAll<HTMLAnchorElement>('.index-row');

    if (preview && previewImg && matchMedia('(hover: hover)').matches) {
      let current = '';

      const move = (e: MouseEvent) => {
        const offset = 24;
        preview.style.transform = `translate(${e.clientX + offset}px, ${e.clientY - 140}px)`;
      };

      rows.forEach((row) => {
        row.addEventListener('mouseenter', () => {
          const src = row.dataset.preview || '';
          if (src !== current) {
            previewImg.src = src;
            current = src;
          }
          preview.classList.add('is-visible');
        });
        row.addEventListener('mousemove', move);
        row.addEventListener('mouseleave', () => {
          preview.classList.remove('is-visible');
        });
      });
    }
  </script>
</Base>
