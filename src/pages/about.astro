---
import Base from '../layouts/Base.astro';
---
<Base title="Обо мне — Герман Сенин" description="Видеомонтажёр Герман Сенин: опыт, подход к монтажу и инструменты.">
  <section class="about wrap hairline-bottom">
    <h1>Maestro.</h1>
    <div class="about-grid">
      <p>
       I’m Hermann, a video editor focused on high-retention lifestyle content and motion-heavy edits.
I’ve worked on videos that reached millions of views, with a strong focus on pacing, storytelling, and keeping people watching. I handle the whole post-production process, from the first cut to sound design, motion graphics, and final polish.
I care about making videos feel engaging rather than overloaded. Every cut, transition, and animation has a purpose: to keep the viewer interested and make the content stand out.
      </p>
      <dl class="facts">
        <div>
          <dt>Stack</dt>
          <dd>Adobe Premiere Pro, Adobe After effects, DaVinci Resolve</dd>
        </div>
        <div>
          <dt>Work Format</dt>
          <dd>Remote, full post-production cycle</dd>
        </div>
        <div>
          <dt>Languages</dt>
          <dd>English, French, Russian, German</dd>
        </div>
      </dl>
    </div>
  </section>

  <style>
    .about {
      padding-top: clamp(56px, 9vw, 100px);
      padding-bottom: 72px;
    }

    .about h1 {
      margin: 0 0 40px;
      font-size: var(--step-3);
      font-weight: 800;
      letter-spacing: -0.02em;
      max-width: 20ch;
    }

    .about-grid {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(220px, 5fr);
      gap: 32px;
    }

    .about-grid p {
      font-size: var(--step-1);
      line-height: 1.6;
      max-width: 58ch;
      margin: 0;
    }

    .facts {
      margin: 0;
      display: grid;
      gap: 20px;
      border-left: 1px solid var(--line);
      padding-left: 24px;
    }

    .facts dt {
      font-size: 0.75rem;
      color: var(--grey);
    }

    .facts dd {
      margin: 4px 0 0;
    }

    @media (max-width: 560px) {
      .about-grid {
        grid-template-columns: 1fr;
      }
      .facts {
        border-left: none;
        padding-left: 0;
        border-top: 1px solid var(--line);
        padding-top: 16px;
      }
    }
  </style>
</Base>
