---
import Base from '../layouts/Base.astro';
---
<Base title="Контакты — Герман Сенин" description="Свяжитесь с Германом Сениным по вопросам монтажа и постпродакшна.">
  <section class="contact wrap">
    <h1>Let's discuss.</h1>
    <ul class="links">
      <li class="hairline-top">
        <a href="mailto:tasselonnd123@gmail.com">
          <span>Email</span>
          <span>tasselonnd123@gmail.com</span>
        </a>
      </li>
      <li class="hairline-top">
        <a href="https://t.me/" target="_blank" rel="noreferrer">
          <span>Telegram</span>
          <span>@toomannythings</span>
        </a>
      </li>
      <li class="hairline-top hairline-bottom">
        <a href="https://x.com/" target="_blank" rel="noreferrer">
          <span>X</span>
          <span>@toomannythings</span>
        </a>
      </li>
    </ul>
  </section>

  <style>
    .contact {
      padding-top: clamp(56px, 9vw, 100px);
      padding-bottom: 96px;
    }

    .contact h1 {
      margin: 0 0 48px;
      font-size: var(--step-3);
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    .links {
      list-style: none;
      margin: 0;
      padding: 0;
      max-width: 720px;
    }

    .links a {
      display: flex;
      justify-content: space-between;
      padding: 22px 0;
      font-size: var(--step-1);
      transition: opacity 0.15s ease;
    }

    .links a:hover,
    .links a:focus-visible {
      opacity: 0.55;
    }

    .links a span:last-child {
      color: var(--grey);
      font-size: 0.9rem;
      align-self: center;
    }
  </style>
</Base>
